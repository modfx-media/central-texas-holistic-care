# Server-only. Never prefix these with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Payload CMS
PAYLOAD_SECRET=
PREVIEW_SECRET=
# Neon pooled connection string (*-pooler.*). Required before /admin, schema push, or cms:import.
