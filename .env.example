# Public https origin. On Vercel this must never be localhost.
NEXT_PUBLIC_SERVER_URL=https://centraltexasholisticcarepllc.com
NEXT_PUBLIC_SITE_URL=https://centraltexasholisticcarepllc.com
# Enables Vercel Blob uploads for Media. Without it, /media 404s in production.
BLOB_READ_WRITE_TOKEN=
